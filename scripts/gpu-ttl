#!/usr/bin/env bash
set -euo pipefail

# spend cap: terminate a pod after N hours, no prompt. runs detached.
# usage: scripts/gpu-ttl <pod_id> <hours>     cancel: scripts/gpu-ttl --cancel <pod_id>

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/scripts/lib/common.sh"

if [[ "${1:-}" == "--cancel" ]]; then
  id="${2:?pod_id}"
  # every timer for this pod, found by its command line (DELETE '/pods/<id>'), not by a pid file: a pid file
  # lives in one checkout's .runtime, and a timer armed from another checkout (an older install) was missed
  # and later terminated a pod that had been extended (2026-11-18).
  n=0
  for pid in $(pgrep -f "DELETE '/pods/$id'" 2>/dev/null || true); do
    pkill -P "$pid" 2>/dev/null || true      # its sleep child, or it lingers as an orphan
    kill "$pid" 2>/dev/null || true
    n=$((n + 1))
  done
  rm -f "$(runtime_file "ttl-$id.pid")"
  info "ttl cancelled for $id ($n timer(s))"
  exit 0
fi

id="${1:?pod_id}"; hours="${2:?hours}"
load_env
source "$ROOT_DIR/scripts/providers/runpod.sh"
log="$(runtime_file "ttl-$id.log")"
secs="$(python3 -c "print(int(float('$hours')*3600))")"
nohup bash -c "
  ROOT_DIR='$ROOT_DIR'; sleep $secs
  source '$ROOT_DIR/scripts/lib/common.sh'; load_env; source '$ROOT_DIR/scripts/providers/runpod.sh'
  if runpod_api DELETE '/pods/$id' >/dev/null 2>&1; then echo \"\$(date) terminated $id\"; else echo \"\$(date) FAILED to terminate $id\"; fi
" >> "$log" 2>&1 &
echo "$!" > "$(runtime_file "ttl-$id.pid")"
at="$(python3 -c "import time,sys;print(time.strftime('%H:%M',time.localtime(time.time()+int(sys.argv[1]))))" "$secs")"   # date -v is macOS-only
info "pod $id will be terminated at $at (log: .runtime/ttl-$id.log)"
