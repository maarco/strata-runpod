# strata runtime (github.com/Niko1221/Strata) on runpod, using its prebuilt image.
# normally driven by bin/strata-on; by hand: PROFILE=strata scripts/gpu-instance create --dry-run
# the image runs strata itself (no sshd).
# api: https://<podId>-8080.proxy.runpod.net/v1  (openai- and anthropic-compatible)
# the key is added per run by strata-on (from ~/.config/strata-runpod/env), never in this file.
# speed settings are left to strata (context, drafting, cache); measured 2026-11-18 on a 5080:
# strata's own tune said "already fastest", and it picked a 64k context by itself.

INSTANCE_NAME=strata
RUNPOD_IMAGE=ghcr.io/niko1221/strata:0.2.16-cuda13
# cuda13 image needs host driver 580+
RUNPOD_MIN_CUDA=13.0

# 16GB card is enough: strata keeps the experts in system RAM (IQ3_XXS needs 64GB RAM, Q2_0 48GB).
# 5080 community $0.39/hr, stock Low on 2026-11-18 (A4000/A5000 had none) -> use gpu-hunt.
RUNPOD_GPU_TYPE_ID="NVIDIA GeForce RTX 5080"
RUNPOD_MIN_RAM_PER_GPU=64
RUNPOD_GPU_COUNT=1
# community is the cheap tier; fine without a network volume
RUNPOD_CLOUD_TYPE=COMMUNITY
RUNPOD_CONTAINER_DISK_GB=30

# model downloads land in /data (the image's volume), a fresh pod volume per pod
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_DATA_CENTER_IDS=
RUNPOD_VOLUME_MOUNT=/data
RUNPOD_VOLUME_GB=120
RUNPOD_PORTS=8080/http
RUNPOD_POD_ENV=FAMILY=qwen,MODEL=IQ3_XXS
