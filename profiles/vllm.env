# vLLM serving Qwen3.8-Flash-Next (NVIDIA NVFP4) on 2x RTX PRO 6000 Blackwell, for several users at once.
# Based on the tested recipe github.com/SirTificate/qwen3.8-flash-next-nvfp4-2x-rtx-pro-6000 (vLLM v0.31.0, TP2,
# MTP n=3), adapted to RunPod: no ipc:host / SYS_PTRACE there, so the per-layer embedding tables stay on the GPUs
# (--engram-config cpu_offload false) instead of pinned host memory. Started by profiles/vllm-start.sh.
# normally driven by bin/strata-on --engine vllm.

INSTANCE_NAME=strata-vllm
RUNPOD_IMAGE=vllm/vllm-openai:v0.31.0@sha256:c1c9f6fd5c109ba7f0546a59f5b2f15fb87f64c77782e90a27b648b42a8e67c3
RUNPOD_MIN_CUDA=13.0
RUNPOD_GPU_TYPE_ID="NVIDIA RTX PRO 6000 Blackwell Server Edition"
RUNPOD_GPU_COUNT=2
RUNPOD_MIN_RAM_PER_GPU=48
RUNPOD_CLOUD_TYPE=COMMUNITY
RUNPOD_CONTAINER_DISK_GB=40

# 132.7 GB of weights land in /data/hf
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_DATA_CENTER_IDS=
RUNPOD_VOLUME_MOUNT=/data
RUNPOD_VOLUME_GB=200
RUNPOD_PORTS=8000/http
RUNPOD_ENTRYPOINT_JSON='["bash","-c"]'
